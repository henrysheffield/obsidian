views:
  - type: cards
    name: Table
    filters:
      and:
        - file.tags.contains("book")
        - file.path.startsWith("00 Notes")
        - '!file.tags.contains("moc")'
    order:
      - file.name
      - author
      - pages
      - rating
      - year
    image: note.cover
    imageFit: contain
    cardSize: 180
